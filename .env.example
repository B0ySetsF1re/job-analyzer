# Local configuration. Copy to `.env` (done by `make install`) and adjust.
# Read by the backend (pydantic-settings) and by docker-compose (variable interpolation).
# Real env vars take precedence over this file in both.

# dev | test | prod
APP_ENV=dev

# Postgres container (docker-compose)
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=job_analyzer

# Backend → Postgres. Host is `localhost` because the API runs on the host;
# the api container gets its own DATABASE_URL (host `postgres`) from docker-compose.
DATABASE_URL=postgresql://app:app@localhost:5432/job_analyzer

# Signs JWT access tokens (HS256), min 32 chars. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars
